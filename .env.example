# Ortak Perde — ortam değişkenleri / environment variables
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# TMDB v3 API anahtarı (opsiyonel). Boş bırakılırsa örnek veri seti kullanılır.
# TMDB v3 API key (optional). Leave empty to use the bundled sample dataset.
TMDB_API_KEY=

# Telefonların erişeceği genel adres (QR kodun içine yazılır). Örn: https://perde.example.com
# Public URL phones should open (encoded in the QR code).
PUBLIC_URL=

# Sunucu portu / server port
PORT=3000
HOST=0.0.0.0

# İzleme platformları bölgesi / watch provider region (ISO 3166-1)
TMDB_REGION=TR

# Ters vekil (reverse proxy) arkasındaysanız true yapın (X-Forwarded-For'a güvenir)
TRUST_PROXY=false

LOG_LEVEL=info
